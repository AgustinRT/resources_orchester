# AI model used to build the embeddings (EmbeddingSettings). Change these values to switch model.
#
# Voyage AI (default):   EMBEDDING_PROVIDER=voyage  EMBEDDING_MODEL=voyage-3.5
#   needs EMBEDDING_API_KEY -> export it in your shell / deployment, NEVER write it in this file.
# Ollama (local, free):  EMBEDDING_PROVIDER=ollama  EMBEDDING_MODEL=nomic-embed-text
#   docker compose --profile ollama up -d && docker exec ollama ollama pull nomic-embed-text
#
# EMBEDDING_BASE_URL empty = provider default (https://api.voyageai.com/v1 | http://localhost:11434)
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=30
